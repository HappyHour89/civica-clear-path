# Copy this file to .env.local and fill in your key. Never commit .env.local.
# Create a key at https://console.anthropic.com (Settings → API Keys).
ANTHROPIC_API_KEY=

# Optional: run Civica on Meta AI instead of Claude.
# CIVICA_PROVIDER=meta
# META_AI_API_KEY=
# CIVICA_MODEL=muse-wonder-1.0        # model name; defaults per provider
# META_AI_BASE_URL=https://api.meta.ai
# CIVICA_WEB_SEARCH=off               # only if the provider rejects the web_search tool

# Optional: Stripe donations on the Support page (see scripts/stripe-setup.mjs).
# Use a restricted key (rk_...) and set both secrets as "sensitive" in Vercel.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=              # from the webhook endpoint for /api/stripe/webhook
# STRIPE_PORTAL_LOGIN_URL=            # printed by scripts/stripe-setup.mjs
# STRIPE_AUTOMATIC_TAX=on             # only after adding a tax registration in Stripe
