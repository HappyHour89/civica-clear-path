# Copy this file to .env.local and fill in your key. Never commit .env.local.
# Create a key at https://console.anthropic.com (Settings → API Keys).
ANTHROPIC_API_KEY=

# Optional: run Civica on Meta AI instead of Claude.
# CIVICA_PROVIDER=meta
# META_AI_API_KEY=
# CIVICA_MODEL=muse-wonder-1.0        # model name; defaults per provider
# META_AI_BASE_URL=https://api.meta.ai
# CIVICA_WEB_SEARCH=off               # only if the provider rejects the web_search tool

# Optional: Stripe donations on the Support page (see scripts/stripe-setup.mjs).
# Use a restricted key (rk_...) and set both secrets as "sensitive" in Vercel.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=              # from the webhook endpoint for /api/stripe/webhook
# STRIPE_PORTAL_LOGIN_URL=            # printed by scripts/stripe-setup.mjs
# STRIPE_AUTOMATIC_TAX=on             # only after adding a tax registration in Stripe

# Review panel: name:passcode pairs (passcodes 8+ characters). Reviewers sign
# in at /review; their name appears on pages they approve.
# REVIEWER_CODES=Maya:change-me-1234,Jordan:change-me-5678
# Optional: key for signing publishable briefings and reviewer sessions.
# Without it, one is derived from the server's AI key.
# PUBLISH_SECRET=
# Newspaper: Vercel Cron sends this to /api/edition/cron (set any long random value).
# CRON_SECRET=

# Optional: get an alert when someone types a wrong review-desk passcode.
# A Slack or Discord incoming-webhook URL, or an ntfy.sh topic URL
# (e.g. https://ntfy.sh/<long-random-topic>) for free phone notifications.
# SECURITY_ALERT_WEBHOOK_URL=

# Monthly AI budget in US dollars (default 10). Civica stops answering new
# questions once its estimated AI spending this month reaches it; the newspaper
# refreshes only while less than half is spent. Also set a spend limit in the
# Anthropic Console (Settings > Limits), which is exact.
# MONTHLY_AI_BUDGET_USD=10
